#!/bin/zsh
# rex-nvim: nvim integration for the Rex terminal on macOS.
#
#   rex-nvim open FILE[:LINE[:COL]]...  open files in the project's nvim, or in a tab of
#                             the Rex "files" session (glow for Markdown)
#   rex-nvim edit [DIR]       start nvim in DIR with the rex-nvim plugin loaded
#   rex-nvim install [--yes] [--scope global|rex]
#                             build NvimOpen.app, ask where files open (global:
#                             Finder and links; rex: only inside Rex) and, for
#                             global, which file types go to nvim, and bind them
#                             (--yes: keep the saved scope, take the suggestions)
#   rex-nvim install EXT...   bind only these extensions to nvim
#   rex-nvim doctor           check tools, the app, file type bindings, the
#                             browser and registered nvim
#
# The script resolves its own path through the ~/.local/bin symlink, so the
# libraries are read from this clone and `git pull` updates everything.

emulate -R zsh
setopt null_glob pipe_fail

REX_NVIM_ROOT=${0:A:h:h}
source $REX_NVIM_ROOT/lib/common.zsh
source $REX_NVIM_ROOT/lib/registry.zsh
source $REX_NVIM_ROOT/lib/rex.zsh

usage() {
  print -r -- "usage: rex-nvim open FILE[:LINE[:COL]]... | edit [DIR] | install [--yes] [--scope global|rex] | install EXT... | doctor [--fix]"
}

case ${1:-} in
  open)
    shift
    source $REX_NVIM_ROOT/lib/open.zsh
    rex_nvim_open "$@"
    ;;
  edit)
    shift
    source $REX_NVIM_ROOT/lib/edit.zsh
    rex_nvim_edit "$@"
    ;;
  install)
    shift
    # Options (or none) run the wizard, which checks them; extensions bind.
    if (( $# == 0 )) || [[ $1 == -* ]]; then
      source $REX_NVIM_ROOT/lib/wizard.zsh
      rex_nvim_wizard "$@"
      integer wizard_status=$?
      (( wizard_status == 64 )) && usage >&2
      exit $wizard_status
    else
      source $REX_NVIM_ROOT/lib/install.zsh
      rex_nvim_install "$@"
    fi
    ;;
  doctor)
    shift
    source $REX_NVIM_ROOT/lib/doctor.zsh
    rex_nvim_doctor "$@"
    integer doctor_status=$?
    (( doctor_status == 64 )) && usage >&2
    exit $doctor_status
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
